generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  projects Project[]

  @@map("users")
}

model Project {
  id          String   @id @default(uuid())
  ownerId     String   @map("owner_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner                     User                       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  endpoints                 ProjectEndpoint[]
  apiKeys                   ApiKey[]
  apiKeyEndpointPermissions ApiKeyEndpointPermission[]
  usageLogs                 UsageLog[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@map("projects")
}

model ProjectEndpoint {
  id          String         @id @default(uuid())
  projectId   String         @map("project_id")
  method      EndpointMethod
  path        String
  routeShape  String         @map("route_shape")
  upstreamUrl String         @map("upstream_url")
  status      EndpointStatus @default(ENABLED)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  project           Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiKeyPermissions ApiKeyEndpointPermission[]
  usageLogs         UsageLog[]

  @@unique([projectId, method, routeShape])
  @@index([projectId])
  @@map("project_endpoints")
}

model ApiKey {
  id        String       @id @default(uuid())
  projectId String       @map("project_id")
  name      String
  prefix    String
  keyHash   String       @unique @map("key_hash")
  status    ApiKeyStatus @default(ACTIVE)
  revokedAt DateTime?    @map("revoked_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  project     Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  permissions ApiKeyEndpointPermission[]
  usageLogs   UsageLog[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([prefix])
  @@map("api_keys")
}

model ApiKeyEndpointPermission {
  id         String   @id @default(uuid())
  apiKeyId   String   @map("api_key_id")
  projectId  String   @map("project_id")
  endpointId String   @map("endpoint_id")
  createdAt  DateTime @default(now()) @map("created_at")

  apiKey   ApiKey          @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  endpoint ProjectEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, endpointId])
  @@index([apiKeyId])
  @@index([projectId])
  @@index([endpointId])
  @@map("api_key_endpoint_permissions")
}

model UsageLog {
  id String @id @default(uuid())

  projectId  String? @map("project_id")
  apiKeyId   String? @map("api_key_id")
  endpointId String? @map("endpoint_id")

  requestMethod EndpointMethod @map("request_method")
  requestPath   String         @map("request_path") @db.VarChar(2048)
  queryString   String?        @map("query_string") @db.VarChar(4096)

  outcome            UsageLogOutcome
  gatewayStatusCode  Int             @map("gateway_status_code")
  upstreamStatusCode Int?            @map("upstream_status_code")
  errorCode          String?         @map("error_code") @db.VarChar(128)

  durationMs Int @map("duration_ms")

  clientIp  String? @map("client_ip") @db.VarChar(128)
  userAgent String? @map("user_agent") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at")

  project  Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  apiKey   ApiKey?          @relation(fields: [apiKeyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  endpoint ProjectEndpoint? @relation(fields: [endpointId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([createdAt, id])
  @@index([projectId, createdAt, id])
  @@index([apiKeyId, createdAt])
  @@index([endpointId, createdAt])
  @@index([projectId, outcome, createdAt])
  @@map("usage_logs")
}

enum EndpointMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum EndpointStatus {
  ENABLED
  DISABLED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum UsageLogOutcome {
  SUCCESS
  API_KEY_MISSING
  API_KEY_INVALID
  API_KEY_REVOKED
  ENDPOINT_NOT_FOUND
  ENDPOINT_DISABLED
  PERMISSION_DENIED
  UPSTREAM_ERROR
  GATEWAY_VALIDATION_ERROR
  UNKNOWN_ERROR
}
