generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  projects Project[]

  @@map("users")
}

model Project {
  id          String   @id @default(uuid())
  ownerId     String   @map("owner_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner                     User                       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  endpoints                 ProjectEndpoint[]
  apiKeys                   ApiKey[]
  apiKeyEndpointPermissions ApiKeyEndpointPermission[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@map("projects")
}

model ProjectEndpoint {
  id          String         @id @default(uuid())
  projectId   String         @map("project_id")
  method      EndpointMethod
  path        String
  routeShape  String         @map("route_shape")
  upstreamUrl String         @map("upstream_url")
  status      EndpointStatus @default(ENABLED)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  project           Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiKeyPermissions ApiKeyEndpointPermission[]

  @@unique([projectId, method, routeShape])
  @@index([projectId])
  @@map("project_endpoints")
}

model ApiKey {
  id        String       @id @default(uuid())
  projectId String       @map("project_id")
  name      String
  prefix    String
  keyHash   String       @unique @map("key_hash")
  status    ApiKeyStatus @default(ACTIVE)
  revokedAt DateTime?    @map("revoked_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  project     Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  permissions ApiKeyEndpointPermission[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([prefix])
  @@map("api_keys")
}

model ApiKeyEndpointPermission {
  id         String   @id @default(uuid())
  apiKeyId   String   @map("api_key_id")
  projectId  String   @map("project_id")
  endpointId String   @map("endpoint_id")
  createdAt  DateTime @default(now()) @map("created_at")

  apiKey   ApiKey          @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  endpoint ProjectEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, endpointId])
  @@index([apiKeyId])
  @@index([projectId])
  @@index([endpointId])
  @@map("api_key_endpoint_permissions")
}

enum EndpointMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum EndpointStatus {
  ENABLED
  DISABLED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}
